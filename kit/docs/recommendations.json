{
  "version": "1.1",
  "description": "Built-in skill recommendations for agents. Not user configuration \u2014 do not ask humans to edit this file.",
  "userConfigSurface": [
    "agents.md",
    "system-design.md",
    "CHANGELOG.md"
  ],
  "when": {
    "starting_project": {
      "read": [
        "agents.md",
        "system-design.md",
        "kit/generated/project-context.json",
        "kit/generated/skills-registry.json"
      ],
      "skills": [
        "ducks-pattern"
      ]
    },
    "writing_code": {
      "read": [
        "system-design.md",
        "agents.md"
      ],
      "skills": [
        "tdd",
        "code-review",
        "ducks-pattern"
      ]
    },
    "designing_ui": {
      "read": [
        "system-design.md"
      ],
      "skills": [
        "ui-ux"
      ]
    },
    "architecting": {
      "read": [
        "system-design.md",
        "agents.md"
      ],
      "skills": [
        "ducks-pattern"
      ]
    },
    "writing_tests": {
      "read": [
        "system-design.md"
      ],
      "skills": [
        "tdd"
      ]
    },
    "reviewing_code": {
      "read": [
        "system-design.md"
      ],
      "skills": [
        "code-review"
      ]
    },
    "documenting": {
      "templates": [
        "kit/templates/spec.md",
        "kit/templates/technical-spec.md",
        "kit/templates/adr.md",
        "system-design.md"
      ]
    },
    "organizing_code": {
      "read": [
        "system-design.md"
      ],
      "skills": [
        "ducks-pattern"
      ]
    }
  },
  "by_phase": {
    "draft": {
      "agent": "product-manager",
      "read": [
        "agents.md",
        "system-design.md"
      ],
      "skills": []
    },
    "spec_approved": {
      "agent": "ux-designer",
      "read": [
        "system-design.md"
      ],
      "skills": [
        "ui-ux"
      ]
    },
    "ux_approved": {
      "agent": "architect",
      "read": [
        "system-design.md"
      ],
      "skills": [
        "ducks-pattern"
      ]
    },
    "tech_approved": {
      "agent": "qa",
      "read": [
        "system-design.md"
      ],
      "skills": [
        "tdd"
      ]
    },
    "test_red": {
      "agent": "developer",
      "read": [
        "system-design.md"
      ],
      "skills": [
        "tdd",
        "code-review",
        "ducks-pattern",
        "ui-ux"
      ]
    },
    "code_review": {
      "agent": "qa",
      "read": [
        "system-design.md"
      ],
      "skills": [
        "code-review"
      ]
    },
    "tested": {
      "agent": "product-manager",
      "read": [
        "agents.md",
        "system-design.md"
      ],
      "skills": []
    }
  },
  "kitRoot": "kit/"
}
