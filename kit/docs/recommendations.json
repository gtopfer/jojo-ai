{
  "version": "2.0",
  "description": "Skill recommendations for agents. Not human config.",
  "userConfigSurface": [
    "agents.md",
    "system-design.md",
    "CHANGELOG.md"
  ],
  "cli": [
    "init",
    "detect",
    "run",
    "sync",
    "version"
  ],
  "interactionModel": {
    "human": "./jojo CLI + any coding agent (LLM-agnostic)",
    "backlog": "agents.md ### Features",
    "machineOnly": [
      "kit/",
      ".ai/"
    ],
    "llmAgnostic": true,
    "singleSourceOfTruth": "agents.md"
  },
  "skillPathPattern": "kit/docs/skills/<id>/SKILL.md",
  "progressiveDisclosure": {
    "l1": "kit/generated/skills-registry.json",
    "l2": "kit/docs/skills/<id>/SKILL.md",
    "l3": "references|scripts|assets"
  },
  "mcp": {
    "note": "Use MCP only if already present in the environment. Do not require human mcp.json setup."
  },
  "when": {
    "starting_project": {
      "cli": [
        "./jojo detect",
        "./jojo run"
      ],
      "skills": [
        "onboard",
        "ducks-pattern",
        "handoff"
      ]
    },
    "writing_code": {
      "skills": [
        "tdd",
        "code-review",
        "ducks-pattern",
        "autonomous-loop",
        "git-hygiene",
        "security-basics"
      ]
    },
    "designing_ui": {
      "skills": [
        "ui-ux",
        "microcopy",
        "a11y"
      ]
    },
    "architecting": {
      "skills": [
        "ducks-pattern",
        "api-contract",
        "delta-spec"
      ]
    },
    "hotfix": {
      "skills": [
        "hotfix-path",
        "tdd",
        "code-review",
        "autonomous-loop",
        "handoff"
      ]
    },
    "brownfield_change": {
      "skills": [
        "delta-spec",
        "handoff",
        "api-contract"
      ]
    }
  },
  "by_phase": {
    "draft": {
      "agent": "product-manager",
      "skills": [
        "delta-spec",
        "handoff"
      ]
    },
    "spec_approved": {
      "agent": "ux-designer",
      "skills": [
        "ui-ux",
        "microcopy",
        "a11y"
      ]
    },
    "ux_approved": {
      "agent": "architect",
      "skills": [
        "ducks-pattern",
        "api-contract",
        "delta-spec"
      ]
    },
    "tech_approved": {
      "agent": "qa",
      "skills": [
        "tdd"
      ]
    },
    "test_red": {
      "agent": "developer",
      "skills": [
        "tdd",
        "code-review",
        "ducks-pattern",
        "ui-ux",
        "autonomous-loop",
        "git-hygiene",
        "security-basics",
        "a11y"
      ]
    },
    "code_review": {
      "agent": "qa",
      "skills": [
        "code-review",
        "security-basics"
      ]
    },
    "tested": {
      "agent": "product-manager",
      "skills": [
        "handoff"
      ]
    }
  }
}
